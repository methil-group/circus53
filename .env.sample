# Unity Editor credentials for docker build
# Copy this file to .env and fill in your credentials:
#   cp .env.sample .env
#
# Then build with:
#   export $(cat .env | xargs) && docker build \
#     --build-arg UNITY_EMAIL \
#     --build-arg UNITY_PASSWORD \
#     --build-arg UNITY_SERIAL \
#     -t dreamcore .
#
# For Unity Personal, leave UNITY_SERIAL empty.

UNITY_EMAIL=your-email@example.com
UNITY_PASSWORD=your-password
# UNITY_SERIAL=   # Uniquement pour licence Pro/Plus
